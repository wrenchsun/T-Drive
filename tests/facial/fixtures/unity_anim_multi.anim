%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!74 &7400000
AnimationClip:
    m_Name: synthetic_multi
    m_SampleRate: 60
    m_RotationCurves:
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: {x: 0, y: 0, z: 0, w: 1}
                    inSlope: {x: 0, y: 0, z: 0, w: 0}
                    outSlope: {x: 0, y: 0, z: 0, w: 0}
                  - serializedVersion: 3
                    time: 1
                    value: {x: 0, y: 0.7071068, z: 0, w: 0.7071068}
                    inSlope: {x: 0, y: 0, z: 0, w: 0}
                    outSlope: {x: 0, y: 0, z: 0, w: 0}
          path: root/head/eye_L
    m_CompressedRotationCurves: []
    m_EulerCurves:
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: {x: 0, y: 0, z: 0}
                  - serializedVersion: 3
                    time: 2
                    value: {x: 0, y: 90, z: 0}
              m_PreInfinity: 2
              m_PostInfinity: 2
              m_RotationOrder: 4
          path: root/head/eye_R
    m_PositionCurves:
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: {x: 0.1, y: 0.2, z: 0.3}
                  - serializedVersion: 3
                    time: 1
                    value: {x: 0.3, y: 0.2, z: -0.1}
          path: root/head/eye_L
    m_ScaleCurves:
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: {x: 1, y: 1, z: 1}
          path: root/head/eye_L
    m_FloatCurves:
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: 0
                  - serializedVersion: 3
                    time: 1
                    value: 100
                  - serializedVersion: 3
                    time: 2
                    value: 50
          attribute: blendShape.bs.mouth_open
          path: mdl_face
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: 40
          attribute: blendShape.bs.smile_L
          path: mdl_face
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: 80
          attribute: blendShape.bs.smile_L
          path: mdl_brow
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: 0.00000001
          attribute: blendShape.bs.tiny
          path: mdl_face
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: 1
          attribute: material._Color.r
          path: mdl_face
        - curve:
              serializedVersion: 2
              m_Curve:
                  - serializedVersion: 3
                    time: 0
                    value: 0
                    outSlope: Infinity
                  - serializedVersion: 3
                    time: 1
                    value: 100
          attribute: blendShape.bs.step_test
          path: mdl_face
    m_PPtrCurves: []
