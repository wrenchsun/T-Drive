{
  "kind": "view_angles",
  "description": "角度の計算。mode=direct/roundtrip は正準空間（cm / Z-up / 左手 / 前 +X）で直接、mode=bone は各環境の座標（space）から正準空間へ変換してから求める",
  "cases": [
    {
      "name": "front_is_zero",
      "source": "UE FacialCoreTests.cpp:ViewAnglesFront",
      "mode": "direct",
      "headPos": [100, 50, 30],
      "headForwardYawDeg": 0,
      "viewerPos": [300, 50, 30],
      "expect": {
        "yawDeg": 0,
        "pitchDeg": 0
      },
      "toleranceDeg": 0.01,
      "note": "対面（前方 +X 側）から → Yaw 0 / Pitch 0"
    },
    {
      "name": "round_trip_yaw30_pitch20",
      "source": "UE FacialCoreTests.cpp:ViewAnglesRoundTrip",
      "mode": "roundtrip",
      "headPos": [100, 50, 30],
      "headForwardYawDeg": 40,
      "yawDeg": 30,
      "pitchDeg": 20,
      "distance": 200,
      "expect": {
        "yawDeg": 30,
        "pitchDeg": 20
      },
      "toleranceDeg": 0.1,
      "note": "視点 = headPos + compute_view_direction(headForwardYawDeg, yawDeg, pitchDeg) × distance を作り、角度が復元されること"
    },
    {
      "name": "camera_left_of_character_is_positive_yaw",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 0,
      "viewerPos": [0, -100, 0],
      "expect": {
        "yawDeg": 90,
        "pitchDeg": 0
      },
      "toleranceDeg": 0.01,
      "note": "UE 正準空間では右 = +Y。-Y 側（キャラクターの左手側）にカメラがあると Yaw 正"
    },
    {
      "name": "camera_right_of_character_is_negative_yaw",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 0,
      "viewerPos": [0, 100, 0],
      "expect": {
        "yawDeg": -90,
        "pitchDeg": 0
      },
      "toleranceDeg": 0.01
    },
    {
      "name": "camera_behind_is_180",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 0,
      "viewerPos": [-100, 0, 0],
      "expect": {
        "yawDeg": 180,
        "pitchDeg": 0
      },
      "toleranceDeg": 0.01
    },
    {
      "name": "camera_above_is_positive_pitch",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 0,
      "viewerPos": [100, 0, 100],
      "expect": {
        "yawDeg": 0,
        "pitchDeg": 45
      },
      "toleranceDeg": 0.01,
      "note": "ふかん = Pitch 正"
    },
    {
      "name": "camera_below_is_negative_pitch",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 0,
      "viewerPos": [100, 0, -100],
      "expect": {
        "yawDeg": 0,
        "pitchDeg": -45
      },
      "toleranceDeg": 0.01,
      "note": "あおり = Pitch 負"
    },
    {
      "name": "camera_straight_above",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 0,
      "viewerPos": [0, 0, 100],
      "expect": {
        "yawDeg": 0,
        "pitchDeg": 90
      },
      "toleranceDeg": 0.01,
      "note": "真上: 水平距離 0 → Pitch 90（Yaw は atan2(0,0) = 0 から）"
    },
    {
      "name": "yaw_wraps_to_minus_180_180",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 170,
      "viewerPos": [0, 100, 0],
      "expect": {
        "yawDeg": 80,
        "pitchDeg": 0
      },
      "toleranceDeg": 0.01,
      "note": "170° - 90° = 80°"
    },
    {
      "name": "yaw_wrap_across_180",
      "source": "python-port",
      "mode": "direct",
      "headPos": [0, 0, 0],
      "headForwardYawDeg": 170,
      "viewerPos": [0, -100, 0],
      "expect": {
        "yawDeg": -100,
        "pitchDeg": 0
      },
      "toleranceDeg": 0.01,
      "note": "170° - (-90°) = 260° → -100°"
    },
    {
      "name": "yaw_exactly_180_stays_positive",
