      "grid": {
        "yawRange": 90,
        "pitchRange": 45,
        "cols": 3,
        "rows": 3,
        "edgeFade": 15
      },
      "layers": [
        {
          "name": "Neutral",
          "enabled": true,
          "emotionWeight": 0,
          "morphs": ["FC_R0_C0", "FC_R0_C1", "FC_R0_C2", "FC_R1_C0", "FC_R1_C1", "FC_R1_C2", "FC_R2_C0", "FC_R2_C1", "FC_R2_C2"]
        }
      ],
      "yaw": -90,
      "pitch": -45,
      "expect": {
        "weights": {
          "FC_R0_C0": 1
        }
      },
      "note": "交点ちょうどではモーフ 1 個のみ・重み 1"
    },
