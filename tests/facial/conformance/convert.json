{
  "kind": "convert",
  "description": "座標系の変換。op = position / direction / quaternion / boneOffset / forwardAxis / mirrorAxis。from / to は meta と同じ {unit, upAxis, handedness}。軸の対応は maya/scripts/tdrive_facial/core/space.py の docstring",
  "cases": [
    {
      "name": "maya_front_to_ue_forward",
      "source": "python-port",
      "op": "position",
      "from": {
        "unit": "cm",
        "upAxis": "Y",
        "handedness": "right"
      },
      "to": {
        "unit": "cm",
        "upAxis": "Z",
        "handedness": "left"
      },
      "input": [0, 0, 100],
      "expect": [100, 0, 0],
      "tolerance": 1e-09,
      "note": "Maya +Z（前）→ UE +X（前）"
    },
    {
      "name": "maya_up_to_ue_up",
      "source": "python-port",
